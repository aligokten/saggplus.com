# Admin panel credentials (required for /admin login)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# Random long secret used to sign admin session cookies.
# Generate one with: openssl rand -base64 48
ADMIN_SESSION_SECRET=change-this-to-a-long-random-string

# Contact form submissions are currently only saved to the database and
# shown at /admin/messages. Email delivery to info@saggplus.com is not
# wired up yet — see README.md for how to enable it with SMTP later.
