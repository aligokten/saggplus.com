# Admin panel credentials (required for /admin login)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# Random long secret used to sign admin session cookies.
# Generate one with: openssl rand -base64 48
ADMIN_SESSION_SECRET=change-this-to-a-long-random-string

# Contact form submissions are currently only saved to the database and
# shown at /admin/messages. Email delivery to info@saggplus.com is not
# wired up yet — see README.md for how to enable it with SMTP later.

# akustik.saggplus.com giriş oturumlarını imzalayan gizli anahtar. Admin
# anahtarından FARKLI olmalıdır. Üretmek için: openssl rand -base64 48
AKUSTIK_SESSION_SECRET=change-this-to-another-long-random-string

# Telegram bildirimi (önerilen). İletişim formu veya staj başvurusu gelince
# Telegram'a mesaj düşer; altında WhatsApp ve Panel düğmeleri olur.
# Bot tokenını @BotFather verir. Sohbet kimliğini bulmak için bota bir mesaj
# yazıp https://api.telegram.org/bot<TOKEN>/getUpdates adresindeki
# "chat":{"id": ...} değerini alın. Birden fazla kişi için virgülle ayırın.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Telefon bildirimi (https://ntfy.sh). İletişim formu veya staj başvurusu
# gelince telefona anlık bildirim gönderir. Boş bırakılırsa bildirim kapalıdır.
# Konu adı herkese açıktır: tahmin edilemeyecek uzun bir ad seçin, ör.
#   echo "saggplus-$(openssl rand -hex 12)"
NTFY_TOPIC=
# Varsayılan https://ntfy.sh. Kendi ntfy sunucunuz varsa adresini yazın.
# NTFY_SERVER=https://ntfy.sh
# Erişim korumalı bir konu kullanıyorsanız ntfy erişim belirteci (tk_...).
# NTFY_TOKEN=
